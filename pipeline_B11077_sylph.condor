# Submit the B11077 Sylph/decontamination regression run as a vanilla-universe
# Nextflow head job. The pipeline's individual tasks are submitted to Condor
# by Nextflow using the resource labels in nextflow.config.
#
# Usage from the submit node:
#   mkdir -p condor_logs
#   condor_submit pipeline_B11077_sylph.condor
#   condor_q
#   condor_rm <cluster_id>
#
# Pin a known session when resuming after a preview or another invocation:
#   RESUME_SESSION=<session-uuid> condor_submit pipeline_B11077_sylph.condor

# The head process may run on an execute node. It must remain vanilla; the
# Canopy bin/condor_submit wrapper routes Nextflow's child submissions to the
# schedd on scarcity-ap-1.glbrc.org.
universe       = vanilla
executable     = run_B11077_sylph_condor.sh
initialdir     = /mnt/cephfs/linuxhome/benucci/Canopy
getenv         = true

# The head process is only an orchestrator; task resources come from
# nextflow.config. Condor owns this foreground process for the full run.
request_cpus   = 2
request_memory = 8GB

notification   = Never

output         = condor_logs/B11077_sylph.stdout.txt
error          = condor_logs/B11077_sylph.stderr.txt
log            = condor_logs/B11077_sylph.condor.log

# Keep failed jobs held for inspection instead of silently removing them.
on_exit_hold   = (ExitCode =!= 0)

queue
