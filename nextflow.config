// ============================================================
// nextflow.config — Canopy (ONT sorghum genome assembly pipeline)
// Default: local; use -profile condor for HTCondor execution
// ============================================================

manifest {
    name            = 'canopy'
    description     = 'ONT-based sorghum genome assembly with organelle separation'
    version         = '0.1.0'
    nextflowVersion = '>=24.04.0'
}

// ---- Default params ----
params {
    reads        = "${projectDir}/reads"
    cp_ref       = null
    mt_ref       = null
    
    organelle_assembler = "flye"        // "flye" or "oatk"
    filter_organelles   = true          // apply reference-based filter post-assembly
    organelle_min_qcov  = 0.5           // min fraction of contig covered by ref alignment
    organelle_min_ident = 0.7           // min identity (matches / alignment_length)
    
    nuclear_ref  = null
    outdir       = "results"
    genome_size  = "780m"
    
    busco_lineage = "poales_odb10"
    medaka_model = "r1041_e82_400bps_sup_v5.2.0"
    
    run_hapdup   = false
    help         = false

    ragtag_correct = true    // ragtag.py correct reduces misassemblies 2398→2309 vs. skipping
    calcuts_args   = ""      // empty = autotune peak from PB.stat; or e.g. "-l 5 -m 22 -u 120"
    // purge_dups ALWAYS runs; both the Medaka and purged genomes are scaffolded, QUAST'd and
    // BUSCO'd for comparison. final_assembly selects which becomes THE published genome (gets
    // Qualimap/BlobTools/Kraken2 + FINAL_SUMMARY). 'medaka' (default) = unpurged; 'purge' = purged.
    final_assembly = 'medaka'   // medaka | purge
    skip_purge     = null       // RETIRED: if set, main.nf errors pointing to --final_assembly
    run_qualimap   = false   // BAM-level QC via Qualimap bamqc (purge + scaffold stages)
    run_blobtools  = false   // GC-vs-coverage blob plots via BlobTools (coverage-only, no taxonomy DB)

    // Contaminant screening: Kraken2 classifies each contig, then BlobTools renders the
    // coverage-vs-GC blob plot coloured by taxonomy. Off by default (needs the big DB below).
    run_kraken2    = false
    // PlusPFP Kraken2 DB (Standard + protozoa/fungi/plant; ~231.5 GB loaded index, 171.8 GB
    // compressed as of the 2026-06-26 build — genome-idx/Langmead prebuilt indexes). Includes
    // a plant clade (PlusPF does not), so host (sorghum) sequence gets a real match instead of
    // being screened by absence. Too big for the 128 GB qc_heavy allocation, so KRAKEN2_CLASSIFY
    // runs under the assemble_heavy label (448 GB, restricted to specific big-RAM nodes — see
    // withLabel: 'assemble_heavy' below) and still loads fully into RAM (no --memory-mapping):
    // the abandoned 456 GB PRAKEN DB showed --memory-mapping's per-k-mer random reads over
    // cephfs never finish, so mmap is not an option here either.
    // Provisioned 2026-07-29 as PlusPFP_protozoa_fungi_plants (same 20260626 build as the
    // self-fetched fallback in modules/dbs.nf, so either source is interchangeable).
    kraken2_db     = '/mnt/cephfs/linuxhome/compbio/nonbackup/databases/PlusPFP_protozoa_fungi_plants'
    // BlobTools resolves Kraken2 taxids → lineage from the DB's own taxdump (nodes.dmp +
    // names.dmp ship inside PlusPFP), keeping classifier and taxonomy the same vintage.
    taxdump_dir    = '/mnt/cephfs/linuxhome/compbio/nonbackup/databases/PlusPFP_protozoa_fungi_plants'
    // Kraken2 with no --confidence lets long contigs get swayed by a handful of incidental
    // k-mer hits into a wrong (sometimes wildly wrong, e.g. "Homo sapiens") whole-sequence
    // call. 0.1 is Kraken2's own commonly-recommended floor for cutting spurious calls
    // without suppressing true positives.
    kraken2_confidence = 0.1

    // Contaminant flagging: flags contigs in the FINAL scaffolded nuclear genome that are
    // simultaneously (a) non-target-phylum by BlobTools/Kraken2, (b) unplaced by RagTag, and
    // (c) outside a normal eukaryotic GC range. All three must hold (AND) — deliberately
    // conservative so real plant sequence divergent from the reference (unplaced but
    // on-target phylum, or unplaced with normal GC) is never removed. Off by default;
    // requires --run_kraken2 and --nuclear_ref (see the validation error in main.nf).
    flag_contaminants     = false
    contam_target_phylum  = 'Streptophyta'   // plant phylum; "no-hit" calls never count as non-plant
    contam_gc_min         = 0.20             // eukaryotic-normal GC fraction, lower bound
    contam_gc_max         = 0.70             // eukaryotic-normal GC fraction, upper bound

    // Sylph corroboration: an independent containment-ANI check (vs GTDB reference genomes)
    // for the (typically very few) contigs --flag_contaminants already flagged — Kraken2's
    // k-mer LCA approach and Sylph's containment-ANI approach fail differently, so agreement
    // between them is stronger evidence than either alone. Advisory only — does not change
    // which contigs REMOVE_CONTAMINANTS removes. Off by default; requires --flag_contaminants.
    verify_sylph   = false
    sylph_db       = "${projectDir}/databases/sylph/gtdb-r226-c200-dbv1.syldb"
    sylph_min_ani  = 90   // sylph query's own default minimum adjusted ANI (0-100)
}

// ---- Apptainer (containers) ----
apptainer {
    enabled    = true
    autoMounts = true
    cacheDir   = "${System.getenv('HOME')}/.apptainer_cache"
    pullTimeout = '60m'
}

// ---- Default process settings & resource labels ----
process {
    // safe defaults
    cpus   = 8
    memory = '32 GB'
    time   = '4h'
    errorStrategy = { task.exitStatus in [132, 137, 139, 143, 247] ? 'retry' : 'finish' }
    maxRetries    = 2
    clusterOptions = 'requirements = Machine != "scarcity-14.glbrc.org"'

    // resource classes (used by per-process labels)
    withLabel: 'qc' {
        cpus   = 16
        memory = '128 GB'
        time   = '12h'
    }
    withLabel: 'qc_heavy' {
        cpus   = 16
        memory = '128 GB'
        time   = '24h'
    }
    withLabel: 'map' {
        cpus   = 24
        memory = '128 GB'
        time   = '12h'
    }
    withLabel: 'assemble_small' {
        cpus   = 16
        memory = '128 GB'
        time   = '6h'
    }
    withLabel: 'assemble_heavy' {
        cpus   = 32
        memory = '448 GB'
        time   = '120h'
        clusterOptions = 'requirements = (' +
            'Machine == "scarcity-1.glbrc.org" || ' +
            'Machine == "scarcity-2.glbrc.org" || ' +
            'Machine == "scarcity-3.glbrc.org" || ' +
            'Machine == "scarcity-4.glbrc.org" || ' +
            'Machine == "scarcity-5.glbrc.org" || ' +
            'Machine == "scarcity-9.glbrc.org" || ' +
            'Machine == "scarcity-11.glbrc.org" || ' +
            'Machine == "scarcity-12.glbrc.org" || ' +
            'Machine == "scarcity-13.glbrc.org" || ' +
            'Machine == "scarcity-20.glbrc.org")'
    }
    withLabel: 'polish' {
        cpus   = 24
        memory = '256 GB'
        time   = '48h'
        // medaka's torch/ONNX binary SIGILLs (exit 132) on scarcity-9's CPU —
        // keep polishing off it (and the default-bad scarcity-14).
        clusterOptions = 'requirements = (Machine != "scarcity-9.glbrc.org" && Machine != "scarcity-14.glbrc.org")'
    }
    withLabel: 'fetch' {
        // Lightweight network I/O (curl/tar), not CPU/RAM-bound — but
        // DOWNLOAD_KRAKEN2_PLUSPFP moves ~172 GB over the network, so give it a
        // generous time budget rather than the 4h process default.
        cpus   = 2
        memory = '8 GB'
        time   = '48h'
    }
}

// ---- Execution profiles ----
profiles {

    standard {
        process.executor = 'local'
    }

    condor {
        process {
            executor = 'condor'
            // HTCondor-specific options can be added per-process via clusterOptions
        }
        executor {
            queueSize       = 50      // max concurrent jobs
            submitRateLimit = '10/1min'
        }
    }

    debug {
        process.beforeScript = 'echo "RUNNING: $HOSTNAME @ $(date)"'
    }
}

// ---- Email notification on pipeline completion ----
notification {
    enabled = true
    to      = 'gian.benucci@gmail.com'
}

// ---- Reporting ----
report {
    enabled   = true
    file      = "${params.outdir}/pipeline_report.html"
    overwrite = true
}

timeline {
    enabled   = true
    file      = "${params.outdir}/timeline.html"
    overwrite = true
}

trace {
    enabled   = true
    file      = "${params.outdir}/trace.txt"
    overwrite = true
    fields    = 'task_id,hash,name,status,exit,realtime,cpus,memory,rss,peak_rss,duration'
}

dag {
    enabled   = true
    file      = "${params.outdir}/dag.html"
    overwrite = true
}

// ---- workDir: point to scratch on HPC ----
// Override on the CLI with: -w /scratch/$USER/nf-work
workDir = "${System.getenv('HOME')}/nf-work-sorghum"
